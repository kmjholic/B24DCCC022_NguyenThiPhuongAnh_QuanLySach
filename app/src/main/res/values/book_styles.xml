<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="blue_dark">#0D47A1</color>
    <color name="blue_main">#1565C0</color>
    <color name="bg_screen">#F4F6F8</color>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryDark">#0D47A1</item>
        <item name="colorAccent">#1565C0</item>
        <item name="colorControlActivated">#1565C0</item>
        <item name="android:statusBarColor">#0D47A1</item>
        <item name="android:windowBackground">#F4F6F8</item>
    </style>

    <style name="Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#6B7785</item>
    </style>

    <style name="Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#1B1F23</item>
        <item name="android:textColorHint">#8A94A0</item>
    </style>

    <style name="BtnPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnOutline" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">#1565C0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnDanger" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Chip">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>